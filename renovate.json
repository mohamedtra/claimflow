{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Europe/Paris",
  "schedule": ["before 7am on monday"],
  "labels": ["type:dependances"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "groupName": "mises à jour mineures"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "allowedVersions": "<19"
    },
    {
      "description": "ADR-017 : TypeScript dans la plage acceptée par Angular 22 (>= 6.0 < 6.1)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<6.1"
    },
    {
      "description": "nginx : branche stable uniquement (mineure paire) ; les mineures impaires sont la branche de développement",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["nginxinc/nginx-unprivileged"],
      "allowedVersions": "/^1\\.\\d*[02468]-alpine$/"
    }
  ]
}
