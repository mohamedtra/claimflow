# Proxy de l'instance (dev). deployer.sh produit nginx.conf à partir de ce modèle en remplaçant
# @SECRET_ORIGINE@ et @HOTE_PUBLIC@ par leurs valeurs (paramètres SSM).

# Toute requête doit venir de CloudFront, qui ajoute cet en-tête secret.
map $http_x_origine_cloudfront $origine_autorisee {
    default              0;
    "@SECRET_ORIGINE@"   1;
}

server {
    listen 8080 default_server;
    server_tokens off;
    client_max_body_size 20m;

    if ($origine_autorisee = 0) {
        return 403;
    }

    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host @HOTE_PUBLIC@;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Origine-CloudFront "";

    # Administration de Keycloak : jamais par Internet (tunnel SSM uniquement). Expression
    # régulière, sans tenir compte de la casse, pour couvrir aussi /auth/admin et
    # /auth/realms/master sans barre finale (nginx décode et normalise l'URI avant de comparer).
    location ~* ^/auth/(admin|realms/master)(/|$) {
        return 403;
    }

    location /auth/ {
        proxy_pass http://keycloak:8080;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
    }

    location /api/ {
        proxy_pass http://api:8080;
    }

    location = /actuator/health {
        proxy_pass http://api:8080;
    }

    location / {
        return 404;
    }
}
