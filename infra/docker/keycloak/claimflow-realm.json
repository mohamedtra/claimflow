{
  "realm": "claimflow",
  "displayName": "ClaimFlow",
  "enabled": true,
  "sslRequired": "external",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "bruteForceProtected": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ASSURE",
        "description": "Assuré : ses dossiers et contrats"
      },
      {
        "name": "GESTIONNAIRE",
        "description": "Gestionnaire : instruit son portefeuille"
      },
      {
        "name": "EXPERT",
        "description": "Expert externe : ses missions"
      },
      {
        "name": "RESPONSABLE",
        "description": "Responsable sinistres : valide et pilote son équipe"
      },
      {
        "name": "ADMIN",
        "description": "Administrateur : paramètres et audit"
      }
    ]
  },
  "clients": [
    {
      "clientId": "claimflow-bff",
      "name": "ClaimFlow BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "claimflow-bff-local",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-claimflow-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "claimflow-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "claimflow-api",
      "name": "ClaimFlow API (audience)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "claimflow-api-local",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
